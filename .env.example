# HRB (horseracebase.com) credentials
HRB_USERNAME=your_hrb_username
HRB_PASSWORD=your_hrb_password

# AWS / S3 credentials for historic database storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=eu-west-1
S3_BUCKET=ashcroft-racing-data
S3_DB_KEY=horse_racing.db

# Email (SMTP) configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# GitHub (for model release downloads)
GITHUB_REPO=tomwilson41986/ashcroft
