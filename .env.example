# HRB (horseracebase.com) credentials
HRB_USERNAME=your_hrb_username
HRB_PASSWORD=your_hrb_password

# AWS / S3 credentials for historic database storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=horseracingresults
S3_DB_KEY=horse_racing.db

# Email (SMTP) configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# GitHub (for model release downloads)
GITHUB_REPO=tomwilson41986/ashcroft

# Betfair Exchange API credentials
BETFAIR_USERNAME=your_betfair_username
BETFAIR_PASSWORD=your_betfair_password
BETFAIR_APP_KEY=your_betfair_app_key
BETFAIR_CERTS_DIR=certs

# Automated betting config (all optional, sensible defaults)
BETTING_ENABLED=true
BETTING_DRY_RUN=true
BETTING_BANKROLL=1000
BETTING_MIN_EDGE=0.05
BETTING_KELLY_FRACTION=0.25
BETTING_MAX_DAILY_LOSS=200
BETTING_MAX_DAILY_EXPOSURE=500
BETTING_MAX_DAILY_BETS=20
